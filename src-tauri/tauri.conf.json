{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1422",
    "frontendDist": "../dist"
  },
  "identifier": "com.magishira.gpopenui",
  "productName": "GP OpenUI",
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "GP OpenUI",
        "center": true,
        "resizable": false,
        "width": 360,
        "height": 520,
        "minWidth": 360,
        "minHeight": 520,
        "label": "main",
        "decorations": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Free, open-source macOS GUI for GlobalProtect VPNs",
    "longDescription": "GP OpenUI is a free, open-source Tauri-based GUI for GlobalProtect VPNs. It handles password, SAML/SSO, and client certificate authentication, and spawns the Homebrew openconnect binary for the VPN tunnel — no proprietary daemon required.",
    "copyright": "GPL-2.0",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": null,
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
